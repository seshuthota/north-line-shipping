  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "api/**/*.ts", "server/**/*.ts", "src/assistant/tools.ts", "src/assistant/replies.ts", "src/shipping.ts", "src/data.ts", "src/types.ts"]
}
